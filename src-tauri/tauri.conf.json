{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "号来",
  "version": "1.0.0-beta.7",
  "mainBinaryName": "号来",
  "identifier": "com.yys.cbg.inspector.tauri",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://127.0.0.1:12832",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "萌新绝学之号来",
        "width": 1180,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: yys-cbg-assets: http://yys-cbg-assets.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:12832",
        "img-src": "'self' data: blob: yys-cbg-assets: http://yys-cbg-assets.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "../public/static-data/assets": "static-data/assets"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNTI5RjM5Q0U2NkU3QzIKUldUQzUyYk9PWjlTUHIvbndhUDFqQjVvNGNCMHRVbUNzQkNjMDZOSjhWSDdpcmhONkpZTVkzRHYK",
      "endpoints": ["https://mxtsl8.cn/desktop-updates/latest.json"]
    }
  }
}

# 开发环境 API：
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/yys-cbg-inspector
# 生产 HTTPS 环境请改成真实域名；API 使用 443 时无需显式写端口：
# NEXT_PUBLIC_API_BASE_URL=https://你的域名/yys-cbg-inspector
# API 若仍单独使用 12377，则该端口也必须由 Nginx 启用 SSL：
# NEXT_PUBLIC_API_BASE_URL=https://你的域名:12377/yys-cbg-inspector

# Next.js Web 服务
WEB_PORT=12831
WEB_HOSTNAME=0.0.0.0

# NestJS 服务
PORT=3001
HOST=0.0.0.0
# 这里填写浏览器访问前端页面的来源，不要填写 API 端口或子目录路径。
# 生产 HTTPS 示例：https://你的域名
CORS_ORIGIN=http://127.0.0.1:12831

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的服务器密码
MYSQL_DATABASE=yys_cbg_inspector

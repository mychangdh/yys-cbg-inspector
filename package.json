{
  "name": "yys-cbg-inspector-tauri",
  "private": true,
  "version": "1.0.0-beta.4",
  "description": "阴阳师藏宝阁数据分析工具的 Tauri 桌面版",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node ./node_modules/typescript/bin/tsc --noEmit",
    "format": "prettier --write .",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node ./node_modules/@tauri-apps/cli/tauri.js build",
    "release:version": "node scripts/set-version.mjs",
    "package": "node scripts/package-tauri.mjs",
    "package:installer": "node scripts/package-tauri.mjs --installer",
    "package:portable": "node scripts/package-tauri.mjs --portable"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "antd": "^5.27.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "@tauri-apps/cli": "^2",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "typescript": "^6.0.3",
    "vite": "^7.0.6"
  }
}

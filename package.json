{
  "name": "yys-cbg-inspector",
  "version": "1.0.0",
  "private": true,
  "description": "YYS CBG account inspector",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 12831",
    "build": "npm run test && npm run build:api && npm run build:next && npm run prepare:standalone && npm run prepare:deployment",
    "build:api": "tsc -p tsconfig.server.json",
    "build:next": "node scripts/build-next.mjs",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "prepare:deployment": "node scripts/prepare-deployment.mjs",
    "start": "node scripts/start-all.mjs",
    "start:all": "node scripts/start-all.mjs",
    "start:web": "node scripts/start-next-standalone.mjs",
    "dev:api": "node scripts/run-tsx.mjs watch server/main.ts",
    "start:api": "node scripts/start-api.mjs",
    "prisma:generate": "node scripts/generate-prisma.mjs",
    "postinstall": "npm run prisma:generate",
    "test": "tsc --noEmit",
    "test:calculator": "tsx scripts/checkCalculator.ts",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/serve-static": "^5.0.3",
    "@prisma/client": "^6.16.2",
    "prisma": "^6.16.2",
    "@reduxjs/toolkit": "^2.12.0",
    "antd": "^5.27.0",
    "axios": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "next": "^15.5.7",
    "next-safe-action": "^8.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}

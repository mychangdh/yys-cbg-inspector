{
  "name": "yys-cbg-inspector",
  "version": "1.0.0-beta.1",
  "description": "YYS CBG account inspector",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run assets:verify && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsc --noEmit",
    "test:calculator": "tsx scripts/checkCalculator.ts",
    "test:native-differential": "tsx scripts/compareNativeSmall.ts",
    "test:native-general": "tsx scripts/compareNativeGeneral.ts",
    "benchmark:real-account": "tsx scripts/benchmarkRealAccount.ts",
    "assets:download": "tsx scripts/downloadStaticAssets.ts",
    "assets:verify": "tsx scripts/verifyStaticAssets.ts",
    "format": "prettier --write .",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently -k \"npm run dev\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:12832 && set ELECTRON_RUN_AS_NODE=&& set VITE_DEV_SERVER_URL=http://127.0.0.1:12832 && electron .\"",
    "electron:dist": "set NODE_OPTIONS=--use-system-ca && npm run build && npm run electron:compile && electron-builder --win nsis"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "antd": "^5.27.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^7.0.6",
    "wait-on": "^9.1.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.yys.cbg.inspector",
    "productName": "号来",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "zh-CN"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/static-data/assets/hao-lai-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
